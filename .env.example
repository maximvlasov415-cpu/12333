# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# Имена/основы имён, на которые бот откликается. Падежи ловятся сами:
# «павл» поймает Павла и Павлу, «паш» — Пашу, Пашке и Пашей.
BOT_NAMES=павлик,павлуш,павел,павл,паш

# Если пусто — бот работает в любом чате. Иначе только в перечисленных id.
ALLOWED_CHAT_IDS=

# --- Бесплатная модель (любой OpenAI-совместимый API) ---
# Вариант 1. Groq — бесплатный тариф, быстрый (ключ: https://console.groq.com/keys)
# Провайдеры регулярно снимают модели с обслуживания. Если в логах 404
# model_not_found — запусти `bash deploy/set_model.sh`, он подберёт живую.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=

# Вариант 2. Google Gemini — бесплатный тариф, лучше всех с русским
# (ключ: https://aistudio.google.com/apikey)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash

# Вариант 3. OpenRouter — модели с суффиксом :free бесплатны
# (ключ: https://openrouter.ai/keys, список: https://openrouter.ai/models?max_price=0)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-chat-v3-0324:free

# Вариант 4. Локальная Ollama — вообще без ключа и без интернета
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=

# --- Поведение ---
# Вероятность влезть в разговор без обращения (0.08 = примерно каждое 12-е сообщение)
RANDOM_REPLY_PROBABILITY=0.08
# Минимум секунд между такими вылазками в одном чате
RANDOM_REPLY_COOLDOWN=180
# Вероятность ответить, когда разговор с Павликом уже идёт (он влезал в последние
# сообщения) — тут кулдаун не действует, чтобы он мог поддержать диалог
FOLLOWUP_PROBABILITY=0.5
# Доля ответов с фирменной фишкой на «-ин» (0.15 = каждый седьмой ответ)
JOKE_PROBABILITY=0.15
# Сколько последних сообщений чата держать в контексте
HISTORY_LIMIT=30

LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.9
LLM_TIMEOUT=30
# Запасной ход под причуды провайдера: JSON, который подмешивается в запрос.
# Например, выключить размышления у reasoning-модели: {"reasoning_effort": "none"}
LLM_EXTRA_PARAMS=

# --- Досье на участников ---
# Файл, где бот хранит, что узнал про пацанов
PROFILE_PATH=profiles.json
# Раз во сколько сообщений чата обновлять досье
PROFILE_UPDATE_EVERY=25
# Сколько тезисов держать на человека
PROFILE_MAX_NOTES=3
PROFILE_MAX_TOKENS=600
