# Токен бота от @BotFather
BOT_TOKEN=

# Бесплатный API-ключ с https://console.groq.com/keys
GROQ_API_KEY=

# Модель Groq (можно оставить по умолчанию)
GROQ_MODEL=llama-3.3-70b-versatile

# Вероятность (0.0-1.0), что бот ответит грубостью на случайное сообщение в чате
TRIGGER_CHANCE=0.04

# Минимальный интервал между "выходками" бота в одном чате, в секундах
COOLDOWN_SECONDS=600

# Максимальная длина генерируемого ответа в токенах
MAX_TOKENS=60
